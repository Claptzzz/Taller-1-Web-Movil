# Conexion a PostgreSQL via Prisma.
# Local (postgres en docker-compose, exponiendo 5432 al host):
DATABASE_URL="postgresql://salud:salud@localhost:5432/salud"
# Produccion (ej. Neon) — recordar sslmode=require:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Secreto usado para firmar los JWT (auth module)
JWT_SECRET="change-me-in-production"

# Puerto en el que escucha NestJS
PORT=3000
