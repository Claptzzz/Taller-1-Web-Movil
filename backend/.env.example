# Conexion a SQLite via Prisma.
# Local (npm run start:dev): ruta relativa al directorio backend/
DATABASE_URL="file:./dev.db"
# En Docker usar ruta ABSOLUTA hacia el volumen persistente:
# DATABASE_URL="file:/app/data/prod.db"

# Secreto usado para firmar los JWT (auth module)
JWT_SECRET="change-me-in-production"

# Puerto en el que escucha NestJS
PORT=3000
